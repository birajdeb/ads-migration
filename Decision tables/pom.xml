<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <groupId>birajdeb_bluepolaris.com.biraj_test.decision_tables</groupId>
    <artifactId>decisionTables</artifactId>
    <version>LATEST-SNAPSHOT</version>
    <name>Decision tables</name>
    <description>Decision tables offer a compact visual representation for specifying actions to perform depending on given conditions. Test</description>
    <packaging>pom</packaging>
    <properties>
        <ads-mojo.version xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">16.0.3</ads-mojo.version>
        <buildTime xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${maven.build.timestamp}</buildTime>
        <decision-ml-predictor.version xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">2.0.4</decision-ml-predictor.version>
        <decisionServiceId xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${project.groupId}:${project.artifactId}</decisionServiceId>
        <engine-api.version xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">3.6.0</engine-api.version>
        <engine-compact-runtime.version xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">3.6.0</engine-compact-runtime.version>
        <jackson.version xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">2.19.0</jackson.version>
        <junit.jupiter.version xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">5.8.0</junit.jupiter.version>
        <maven-antrun-plugin.version xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">3.1.0</maven-antrun-plugin.version>
        <maven-dependency-plugin.version xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">3.6.1</maven-dependency-plugin.version>
        <maven-shade-plugin.version xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">3.5.2</maven-shade-plugin.version>
        <maven-surefire-plugin.version xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">3.2.5</maven-surefire-plugin.version>
        <maven.build.timestamp.format xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">yyyy-MM-dd'T'HH:mm:ss'Z'</maven.build.timestamp.format>
        <maven.compiler.source xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">21</maven.compiler.source>
        <maven.compiler.target xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">21</maven.compiler.target>
        <ml-integration-runtime.version xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">50.1.5</ml-integration-runtime.version>
        <project.build.sourceEncoding xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">UTF-8</project.reporting.outputEncoding>
    </properties>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.ibm.decision</groupId>
                <artifactId>engine-compact-runtime</artifactId>
                <version>${engine-compact-runtime.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>com.ibm.decision</groupId>
                <artifactId>engine-de-api</artifactId>
                <version>${engine-api.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.datatype</groupId>
                <artifactId>jackson-datatype-jsr310</artifactId>
                <version>${jackson.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter-api</artifactId>
                <version>${junit.jupiter.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter-engine</artifactId>
                <version>${junit.jupiter.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <modules>
        <module>.decisionservice</module>
        <module>AAA</module>
        <module>Data</module>
        <module>Level 1 - Simple table</module>
        <module>Level 2 - Complex columns</module>
        <module>Level 3 - Multiple conditions</module>
        <module>Level 4 - Complex types and multiple actions</module>
        <module>Test</module>
        <module>Biraj Test</module>
    </modules>
    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>com.ibm.decision</groupId>
                    <artifactId>build-maven-plugin</artifactId>
                    <version>${ads-mojo.version}</version>
                    <dependencies>
                        <dependency>
                            <groupId>com.ibm.decision</groupId>
                            <artifactId>decision-ml-predictor</artifactId>
                            <version>${decision-ml-predictor.version}</version>
                        </dependency>
                    </dependencies>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                    <configuration>
                        <redirectTestOutputToFile>true</redirectTestOutputToFile>
                        <statelessTestsetReporter implementation="org.apache.maven.plugin.surefire.extensions.junit5.JUnit5Xml30StatelessReporter">
                            <disable>false</disable>
                            <version>3.0</version>
                            <usePhrasedFileName>false</usePhrasedFileName>
                            <usePhrasedTestSuiteClassName>true</usePhrasedTestSuiteClassName>
                            <usePhrasedTestCaseClassName>true</usePhrasedTestCaseClassName>
                            <usePhrasedTestCaseMethodName>true</usePhrasedTestCaseMethodName>
                        </statelessTestsetReporter>
                        <consoleOutputReporter implementation="org.apache.maven.plugin.surefire.extensions.junit5.JUnit5ConsoleOutputReporter">
                            <disable>false</disable>
                            <encoding>UTF-8</encoding>
                            <usePhrasedFileName>false</usePhrasedFileName>
                        </consoleOutputReporter>
                        <statelessTestsetInfoReporter implementation="org.apache.maven.plugin.surefire.extensions.junit5.JUnit5StatelessTestsetInfoReporter">
                            <disable>false</disable>
                            <usePhrasedFileName>false</usePhrasedFileName>
                            <usePhrasedClassNameInRunning>true</usePhrasedClassNameInRunning>
                            <usePhrasedClassNameInTestCaseSummary>true</usePhrasedClassNameInTestCaseSummary>
                        </statelessTestsetInfoReporter>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
