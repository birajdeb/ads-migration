<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<com.ibm.rules.studio.model.decisionmodel:DecisionModel xmlns:com.ibm.rules.studio.model.decisionmodel="http://com.ibm.rules.studio/model/decisionmodel.ecore" xmlns:xmi="http://www.omg.org/XMI" xmi:version="2.0">
    <name>decisionModel</name>
    <uuid>5429e961-38f3-470e-a43c-902f244e1e16</uuid>
    <locale>en_US</locale>
    <definition>
        <definitions id="decisions" name="diagram" namespace="" xmlns="http://www.omg.org/spec/DMN/20180521/MODEL/">
            <extensionElements>
                <locale id="en_US" xmlns="http://www.ibm.com/spec/ODM/dmn.xsd"/>
            </extensionElements>
            <inputData id="node_0" name="Input">
                <description>test</description>
                <extensionElements>
                    <initialization xmlns="http://www.ibm.com/spec/ODM/dmn.xsd">
                        <output bomType="com.ibm.ads.samples.training.decision_tables.data.Result" collection="false" name="Input"/>
                    </initialization>
                </extensionElements>
                <variable id="node_0_ii" name="Input" typeRef="com.ibm.ads.samples.training.decision_tables.data.Result"/>
            </inputData>
            <decision id="node_1" name="Decision">
                <extensionElements>
                    <ruleset conflictResolution="sequence" xmlns="http://www.ibm.com/spec/ODM/dmn.xsd">
                        <input bomType="com.ibm.ads.samples.training.decision_tables.data.Result" collection="false" name="Input"/>
                        <input bomType="com.ibm.ads.samples.training.decision_tables.data.Result" collection="false" name="Discount and reward"/>
                        <output bomType="com.ibm.ads.samples.training.decision_tables.data.TestEnum" collection="false" name="Decision"/>
                        <rule defaultRule="false" href="node_1/Decision.dmt" kind="DecisionTable" name="abc"/>
                    </ruleset>
                </extensionElements>
                <variable id="node_1_ii" name="Decision" typeRef="com.ibm.ads.samples.training.decision_tables.data.TestEnum"/>
                <informationRequirement>
                    <requiredInput href="#node_0"/>
                </informationRequirement>
                <informationRequirement>
                    <requiredInput href="#node_2"/>
                </informationRequirement>
            </decision>
            <businessKnowledgeModel id="node_2" name="Discount and reward">
                <extensionElements>
                    <properties xmlns="http://www.ibm.com/spec/ODM/dmn.xsd">
                        <property name="ads.designer.bkKind"><![CDATA[decision]]></property>
                    </properties>
                </extensionElements>
                <variable name="Discount and reward" typeRef="com.ibm.ads.samples.training.decision_tables.data.Result"/>
                <encapsulatedLogic typeRef="com.ibm.ads.samples.training.decision_tables.data.Result">
                    <formalParameter name="customer" typeRef="com.ibm.ads.samples.training.decision_tables.data.Customer"/>
                    <formalParameter name="orderAmount" typeRef="java.lang.Double"/>
                    <formalParameter name="messages" typeRef="java.util.List"/>
                    <context>
