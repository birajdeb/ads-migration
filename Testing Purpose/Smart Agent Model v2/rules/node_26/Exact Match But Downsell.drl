<?xml version="1.0" encoding="UTF-8"?>
<ilog.rules.studio.model.brl:ActionRule xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:ilog.rules.studio.model.brl="http://ilog.rules.studio/model/brl.ecore">
  <name>Exact Match But Downsell</name>
  <uuid>ae2be95c-5cc9-4b79-8bfc-de142679fddf</uuid>
  <locale>en_US</locale>
  <definition><![CDATA[definitions
set 'a Car Approval List Downsell' to all Car Approval Lists in 'Car Approval List' where the Upsell Downsell of each Car Approval List is Downsell ;
set 'a Maximum Car Price' to the maximum  of the Car Prices of 'a Car Approval List Downsell';
set 'a Maximum Car' to a Car Approval List in 'a Car Approval List Downsell' where the Car Price of this Car Approval List is 'a Maximum Car Price';

if 'a Maximum Car' is defined and decision is undefined and 'Customer Eligibility' is Eligible and 'Approval Type' is Match 
then
set decision to a new Smart Agent Output where
		Applied Indicator is false , 
		the Approval is Approve , 
		the Car ID is the Car ID of 'a Maximum Car' , 
		the Car Price is the Car Price of 'a Maximum Car' , 
		the Upsell Downsell is the Upsell Downsell of 'a Maximum Car' ;]]></definition>
</ilog.rules.studio.model.brl:ActionRule>
