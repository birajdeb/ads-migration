                                <Property Name="Check.Gap" Type="xs:boolean"><![CDATA[false]]></Property>
                            </Properties>
                            <ExpressionDefinition>
                                <Text><![CDATA[the Claim Diagnosis Code 1 of 'Claim Diagnosis Code List' is <a string>]]></Text>
                            </ExpressionDefinition>
