<?xml version="1.0" encoding="UTF-8"?>
<ilog.rules.studio.model.brl:ActionRule xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:ilog.rules.studio.model.brl="http://ilog.rules.studio/model/brl.ecore">
  <name>Smart Agent Upsell</name>
  <uuid>acdeed7b-6bd0-4552-9f81-b73db776c9e2</uuid>
  <locale>en_US</locale>
  <definition><![CDATA[definitions
set 'a Car Approval List Upsell' to all Car Approval Lists in 'Car Approval List' 
	where the Upsell Downsell of each Car Approval List is Upsell ;
set 'a Minimum Price' to the minimum of the Car Prices of 'a Car Approval List Upsell';
set 'a Minimum Price Car Upsell' to a Car Approval List in 'a Car Approval List Upsell' where the Car Price of this Car Approval List is 'a Minimum Price'; 

if 'Approval Type' is Upsell and 'Customer Eligibility' is Eligible 
then
set decision to a new Smart Agent Output where
		Applied Indicator is false , 
		the Approval is Approve , 
		the Car ID is the Car ID of 'a Minimum Price Car Upsell' , 
		the Car Price is the Car Price of 'a Minimum Price Car Upsell' , 
		the Upsell Downsell is the Upsell Downsell of 'a Minimum Price Car Upsell' ;]]></definition>
</ilog.rules.studio.model.brl:ActionRule>
