<?xml version="1.0" encoding="UTF-8"?>
<com.ibm.rules.studio.model.decisionmodel:DecisionModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:com.ibm.rules.studio.model.decisionmodel="http://com.ibm.rules.studio/model/decisionmodel.ecore">
  <name>decisionModel</name>
  <uuid>0ac39b6a-cc68-4ada-b6d0-ab2ad0676f28</uuid>
  <locale>en_US</locale>
  <definition><definitions xmlns="http://www.omg.org/spec/DMN/20180521/MODEL/" id="decisions" name="diagram" namespace="">
    <extensionElements>
        <locale xmlns="http://www.ibm.com/spec/ODM/dmn.xsd" id="en_US"/>
    </extensionElements>
    <inputData id="node_0" name="Pincode">
        <extensionElements>
            <initialization xmlns="http://www.ibm.com/spec/ODM/dmn.xsd">
                <output bomType="agull.auto_loan_demo.auto_loan_service.datastructure.Pincode" collection="false" name="Pincode"/>
                <rule defaultRule="true" href="node_0/default-value-setting.drl" kind="BusinessRule" name="default-value-setting"/>
            </initialization>
        </extensionElements>
        <variable id="node_0_ii" name="Pincode" typeRef="agull.auto_loan_demo.auto_loan_service.datastructure.Pincode"/>
    </inputData>
    <decision id="node_1" name="Multiple Level">
        <extensionElements>
            <ruleset xmlns="http://www.ibm.com/spec/ODM/dmn.xsd" conflictResolution="sequence">
                <input bomType="agull.auto_loan_demo.auto_loan_service.datastructure.Pincode" collection="false" name="Pincode"/>
                <input bomType="agull.auto_loan_demo.auto_loan_service.datastructure.CustomerDetail" collection="false" name="Customer Detail"/>
                <output bomType="agull.auto_loan_demo.auto_loan_service.datastructure.FinalCustomerInfo" collection="false" name="Multiple Level"/>
                <rule defaultRule="false" href="node_1/Test.dmt" kind="DecisionTable" name="Test"/>
                <rule defaultRule="true" href="node_1/output-default-setting.drl" kind="BusinessRule" name="output-default-setting"/>
            </ruleset>
        </extensionElements>
        <variable id="node_1_ii" name="Multiple Level" typeRef="agull.auto_loan_demo.auto_loan_service.datastructure.FinalCustomerInfo"/>
        <informationRequirement>
            <requiredInput href="#node_0"/>
        </informationRequirement>
        <informationRequirement>
            <requiredInput href="#node_2"/>
        </informationRequirement>
    </decision>
    <inputData id="node_2" name="Customer Detail">
        <extensionElements>
            <initialization xmlns="http://www.ibm.com/spec/ODM/dmn.xsd">
                <output bomType="agull.auto_loan_demo.auto_loan_service.datastructure.CustomerDetail" collection="false" name="Customer Detail"/>
            </initialization>
        </extensionElements>
        <variable id="node_2_ii" name="Customer Detail" typeRef="agull.auto_loan_demo.auto_loan_service.datastructure.CustomerDetail"/>
    </inputData>
    <decision id="node_3" name="Blank Value">
        <extensionElements>
            <ruleset xmlns="http://www.ibm.com/spec/ODM/dmn.xsd" conflictResolution="sequence">
                <input bomType="agull.auto_loan_demo.auto_loan_service.datastructure.Pincode" collection="false" name="Pincode"/>
                <input bomType="agull.auto_loan_demo.auto_loan_service.datastructure.CustomerDetail" collection="false" name="Customer Detail"/>
                <output bomType="agull.auto_loan_demo.auto_loan_service.datastructure.FinalCustomerInfo" collection="true" name="Blank Value"/>
                <rule defaultRule="false" href="node_3/Trial%202.dmt" kind="DecisionTable" name="Trial 2"/>
                <rule defaultRule="true" href="node_3/output-default-setting.drl" kind="BusinessRule" name="output-default-setting"/>
            </ruleset>
        </extensionElements>
        <variable id="node_3_ii" name="Blank Value" typeRef="agull.auto_loan_demo.auto_loan_service.datastructure.FinalCustomerInfo[]"/>
        <informationRequirement>
            <requiredInput href="#node_0"/>
        </informationRequirement>
        <informationRequirement>
            <requiredInput href="#node_2"/>
        </informationRequirement>
    </decision>
</definitions>
</definition>
</com.ibm.rules.studio.model.decisionmodel:DecisionModel>
