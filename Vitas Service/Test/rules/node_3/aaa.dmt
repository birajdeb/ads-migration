		</Properties>
		<Structure>
			<ConditionDefinitions>
				<ConditionDefinition Id="C0">
					<ExpressionDefinition>
						<Text><![CDATA[the Toileting ADL Change of the attr1 of the atrr3 of 'Input 4' is <an ADL Change>]]></Text>
					</ExpressionDefinition>
				</ConditionDefinition>
				<ConditionDefinition Id="C1">
					<ExpressionDefinition>
						<Text><![CDATA[the number of elements in the Increasing Time to Task ADL Lists of the attr1 of the atrr3 of 'Input 4' equals <a number>]]></Text>
					</ExpressionDefinition>
				</ConditionDefinition>
			</ConditionDefinitions>
			<ActionDefinitions>
				<ActionDefinition Id="A0">
					<ExpressionDefinition>
						<Text><![CDATA[set decision to a new Entity1 where
	the atrr2 is <atrr2> , 
	the atrr3 is <atrr3> , 
	the attr1 is <attr1>]]></Text>
					</ExpressionDefinition>
				</ActionDefinition>
			</ActionDefinitions>
		</Structure>
